{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classnest",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CLASSROOM", "class_name": "ClassroomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClassroomDO"] }]
  // 部署專屬的值不寫在這裡，由部署端注入（見 README「自架」）：
  //   GOOGLE_CLIENT_ID     Google 登入的用戶端 ID（公開值）
  //   FIRST_TEACHER_EMAIL  第一位老師的 Google 信箱
}
